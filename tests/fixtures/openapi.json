    "/api/v1/projects/{projectId}/requests": {
      "get": {
        "tags": [
          "Requests"
        ],
        "summary": "List Requests",
        "description": "Lists the Requests in the Date range `from` to `to` (both required, `yyyy-MM-dd`, UTC, both days counted). Each row has the `timestamp` (a UTC instant), the full `url` with its query string, the `userId`, the `userName` (null when the app sent none), the `processingTimeMs` (null when the app sent none), and the `tags` (each Tag name with its value). The user ids, user names, and URLs are people's data, as the Requests page shows them. `tag` is repeatable `key=value`: Requests must match every key, with any of the values given for it. `search` keeps the Requests whose URL, user id, or user name contains the text. `sortBy` is `timestamp`, `url`, or `user`, in the `sortDirection` `asc` (the default) or `desc`; without `sortBy` the newest Request comes first. `page` (from 1, default 1) and `pageSize` (1 to 250, default 50) page the Requests; `total` is the number of Requests over all pages.",
        "operationId": "requests.list",
        "parameters": [
          {
            "name": "projectId",
            "in": "path",
            "required": true,
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "from",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "to",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "tag",
            "in": "query",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          {
            "name": "search",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sortBy",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sortDirection",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int32"
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiRequests"
                }
              }
            }
          },
          "401": {
            "description": "`unauthorized`: No bearer, or an unknown, ended, or expired credential. `WWW-Authenticate` names the Protected Resource Metadata.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "x-problem-types": [
              "unauthorized"
            ]
          },
          "403": {
            "description": "`no-account`: The credential is in no Account the User belongs to. `accounts` lists where it can switch to. `license-closed`: The Account's Statistics License is Closed. `detail` gives the reason. `browser-handoff`: A person must finish this act in the browser: open `handoffUrl`.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "x-problem-types": [
              "no-account",
              "license-closed",
              "browser-handoff"
            ]
          },
          "404": {
            "description": "`not-found`: No such record in this Account.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "x-problem-types": [
              "not-found"
            ]
          },
          "422": {
            "description": "`validation`: The input was refused. `errors` lists fields for a body or query that does not bind; otherwise `detail` gives the rule.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "x-problem-types": [
              "validation"
            ]
          },
          "429": {
