        "operationId": "projects.list",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiListOfApiProjectListItem"
                }
              }
            }
          },
          "401": {
            "description": "`unauthorized`: No bearer, or an unknown, ended, or expired credential. `WWW-Authenticate` names the Protected Resource Metadata.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "x-problem-types": [
              "unauthorized"
            ]
          },
          "403": {
            "description": "`no-account`: The credential is in no Account the User belongs to. `accounts` lists where it can switch to. `license-closed`: The Account's Statistics License is Closed. `detail` gives the reason. `browser-handoff`: A person must finish this act in the browser: open `handoffUrl`.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "x-problem-types": [
              "no-account",
              "license-closed",
              "browser-handoff"
            ]
          },
          "429": {
            "description": "`rate-limited`: Over the per-User rate limit. `Retry-After` says when to try again.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "x-problem-types": [
              "rate-limited"
            ]
          }
        }
      },
