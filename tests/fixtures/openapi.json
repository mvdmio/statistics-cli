    "/api/v1/accounts/{accountId}/switch": {
      "post": {
        "tags": [
          "Accounts"
        ],
        "summary": "Switch the credential to another Account",
        "description": "Moves the credential into the Account `accountId`, so every later call acts there until the next switch. Answers with the Account list, the new Account marked `current`. An Account the User is not in answers `not-found`.",
