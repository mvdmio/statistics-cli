    "/api/v1/accounts": {
      "get": {
        "tags": [
          "Accounts"
        ],
        "summary": "List the User's Accounts",
        "description": "Lists every Account the signed-in User belongs to, each with `current` true for the Account the credential acts in now. Works even when the current Account is unusable (no membership, a Closed License, no Legal Acceptance), so call it first when another call answers `no-account`.",
